#!/bin/bash

if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr is not installed. Run ./setup.sh or install it with: brew install herdr"
    exit 1
fi

PROJECTS_DIR="${IDE_PROJECTS_DIR:-$HOME/projects}"
WORKTREES_DIR="$PROJECTS_DIR/.worktrees"

# ─── JSON helpers ──────────────────────────────────────────

json_find_value() {
    local json="$1"
    local field="$2"
    printf '%s\n' "$json" \
        | awk -v field="$field" '
            {
              pattern = "\"" field "\"[[:space:]]*:[[:space:]]*\"[^\"]+\""
              if (match($0, pattern)) {
                value = substr($0, RSTART, RLENGTH)
                sub("^\"" field "\"[[:space:]]*:[[:space:]]*\"", "", value)
                sub(/"$/, "", value)
                print value
                exit
              }
            }
          '
}

json_find_workspace_id_for_cwd() {
    local json="$1"
    local cwd="$2"
    printf '%s\n' "$json" \
        | tr '\n' ' ' \
        | sed 's/},{/}\
{/g' \
        | awk -v cwd="$cwd" '
            index($0, "\"cwd\":\"" cwd "\"") {
              if (match($0, /"workspace_id"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                workspace_id = substr($0, RSTART, RLENGTH)
                sub(/^"workspace_id"[[:space:]]*:[[:space:]]*"/, "", workspace_id)
                sub(/"$/, "", workspace_id)
                print workspace_id
                exit
              }
            }
          '
}

json_find_worktree_path_for_branch() {
    local json="$1"
    local branch="$2"
    printf '%s\n' "$json" \
        | tr '\n' ' ' \
        | sed 's/},{/}\
{/g' \
        | awk -v branch="$branch" '
            index($0, "\"branch\":\"" branch "\"") {
                if (match($0, /"path":"[^"]+"/)) {
                    val = substr($0, RSTART, RLENGTH)
                    sub(/^"path":"/, "", val)
                    sub(/"$/, "", val)
                    print val
                    exit
                }
            }
          '
}

# Outputs TAB-separated rows, one worktree per line:
#   slot \t branch \t path \t agent_status \t pane_id \t workspace_id
#
# Sorted: non-fan worktrees first (alphabetically by branch),
#         then fan worktrees by slot number ascending.
# agent_status = "none" when no agent workspace is open for this worktree.
list_worktrees_with_status() {
    local git_root="$1"
    local fan_only="${2:-false}"

    local wt_json agent_json
    wt_json=$(herdr worktree list --cwd "$git_root" --json 2>/dev/null || true)
    agent_json=$(herdr agent list 2>/dev/null || true)

    [[ -z "$wt_json" ]]    && wt_json='{"result":{"worktrees":[]}}'
    [[ -z "$agent_json" ]] && agent_json='{"result":{"agents":[]}}'

    jq -r --argjson agents "$agent_json" --arg fan_only "$fan_only" '
      ($agents.result.agents // [] | map({key: .workspace_id, value: .}) | from_entries) as $agent_map |
      [
        .result.worktrees[] |
        (.branch // "") as $branch_str |
        select(if $fan_only == "true" then ($branch_str | startswith("fan/")) else true end) |
        (.open_workspace_id // "") as $wid |
        ($wid | if . != "" then $agent_map[.] else null end) as $agent |
        (if ($branch_str | test("^fan/.+-[0-9]+$"))
         then ($branch_str | match(".+-([0-9]+)$").captures[0].string | tonumber)
         else -1 end) as $slot_num |
        {
          slot:         (if $slot_num >= 0 then ($slot_num | tostring) else "-" end),
          branch:       (if .branch != null then .branch else "(detached)" end),
          path:         .path,
          agent_status: ($agent.agent_status // "none"),
          pane_id:      ($agent.pane_id // ""),
          workspace_id: $wid,
          is_fan:       (if $slot_num >= 0 then 1 else 0 end),
          slot_num:     $slot_num
        }
      ] |
      sort_by([.is_fan, (if .is_fan == 1 then .slot_num else .branch end)]) |
      .[] |
      [.slot, .branch, .path, .agent_status, .pane_id, .workspace_id] |
      @tsv
    ' <<< "$wt_json"
}

# ─── Helpers ───────────────────────────────────────────────

ensure_herdr_server() {
    if herdr status server >/dev/null 2>&1; then
        return 0
    fi
    herdr server >/tmp/herdr-server.log 2>&1 &
    local i
    for i in $(seq 1 10); do
        sleep 0.5
        herdr status server >/dev/null 2>&1 && return 0
    done
    echo "Warning: herdr server may not be ready" >&2
}

# Returns herdr workspace label for a path.
# Uses --git-common-dir so worktrees get the same repo name as the main checkout.
compute_label() {
    local path="$1"
    local git_common_dir repo_name dir_name label
    git_common_dir=$(git -C "$path" rev-parse --git-common-dir 2>/dev/null || true)
    if [[ -z "$git_common_dir" ]]; then
        label=$(basename "$path" | tr '.' '_' | tr ':' '_')
        printf '%s\n' "$label"
        return
    fi
    if [[ "$git_common_dir" == ".git" ]]; then
        repo_name=$(basename "$path")
    else
        repo_name=$(basename "$(dirname "$git_common_dir")")
    fi
    dir_name=$(basename "$path")
    if [[ "$dir_name" == "$repo_name" ]]; then
        label="$repo_name"
    else
        label="${repo_name}_${dir_name}"
    fi
    label="${label//./_}"
    label="${label//:/_}"
    printf '%s\n' "$label"
}

make_slug() {
    local input="$1"
    local max_len="${2:-30}"
    local slug
    slug=$(printf '%s' "$input" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | LC_ALL=C tr -cs 'a-z0-9' '-' \
        | sed 's/^-*//; s/-*$//')
    slug="${slug:0:$max_len}"
    slug="${slug%-}"
    if [[ ${#slug} -lt 2 ]]; then
        slug="task-$(date +%H%M%S)"
    fi
    printf '%s\n' "$slug"
}

make_branch_slug() {
    local branch="$1"
    printf '%s' "$branch" \
        | tr '/' '-' \
        | tr -d '~^:?*[\\' \
        | sed 's/\.\./-/g; s/^-*//; s/-*$//'
}

detect_project() {
    local project_arg="${1:-}"
    local git_root=""

    if [[ -n "$project_arg" ]]; then
        git_root=$(cd "$project_arg" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
        if [[ -z "$git_root" ]]; then
            echo "Not a git repo: $project_arg" >&2
            return 1
        fi
    else
        git_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    fi

    if [[ -z "$git_root" ]]; then
        local project_path
        project_path=$(find "$PROJECTS_DIR" -maxdepth 3 -name ".git" 2>/dev/null \
            | xargs -n1 dirname 2>/dev/null \
            | grep -v '\.worktrees' \
            | sort -u \
            | fzf --prompt="Project > ")
        if [[ -z "$project_path" ]]; then
            echo "No project selected" >&2
            return 1
        fi
        git_root=$(cd "$project_path" && git rev-parse --show-toplevel 2>/dev/null)
    fi

    printf '%s\n' "$git_root"
}

focus_or_create_workspace() {
    local label="$1"
    local cwd="$2"
    local force_new="${3:-false}"
    local workspace_id open_output git_root

    git_root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)

    if [[ -n "$git_root" ]] && [[ "$force_new" != "true" ]]; then
        open_output=$(herdr worktree open \
            --path "$git_root" \
            --cwd "$cwd" \
            --label "$label" \
            --focus \
            --json 2>/dev/null || true)

        if printf '%s\n' "$open_output" | grep -q '"already_open":true'; then
            workspace_id=$(json_find_value "$open_output" "workspace_id")
            echo "$workspace_id existing"
            return 0
        fi

        workspace_id=$(json_find_value "$open_output" "workspace_id")
        echo "$workspace_id created"
        return 0
    fi

    # Non-git: pane list detection + workspace create
    local pane_output create_output
    if [[ "$force_new" != "true" ]]; then
        pane_output=$(herdr pane list 2>/dev/null || true)
        workspace_id=$(json_find_workspace_id_for_cwd "$pane_output" "$cwd")
        if [[ -n "$workspace_id" ]]; then
            herdr workspace focus "$workspace_id" >/dev/null 2>&1 || true
            echo "$workspace_id existing"
            return 0
        fi
    fi

    create_output=$(herdr workspace create --cwd "$cwd" --label "$label" --focus 2>/dev/null || true)
    workspace_id=$(json_find_value "$create_output" "workspace_id")
    echo "$workspace_id created"
}

# Agent layout: Tab 1 ("agent") = claude (50%) | nvim (32%) | copse-tree (18%)
# Args: workspace_id, is_new, cwd
# Stdout: first pane_id when is_new=true (for caller to start claude there)
start_agent_layout() {
    local workspace_id="$1"
    local cwd="${3:-}"

    [[ -z "$workspace_id" ]] && return 0

    local pane_output pane_id pane_count
    pane_output=$(herdr pane list --workspace "$workspace_id" 2>/dev/null || true)
    pane_count=$(printf '%s\n' "$pane_output" | grep -o '"pane_id"' | wc -l | tr -d ' ')
    [[ "$pane_count" -gt 1 ]] && return 0

    # First non-agent pane
    pane_id=$(printf '%s\n' "$pane_output" \
        | tr '\n' ' ' \
        | sed 's/},{/}\
{/g' \
        | awk '
            {
                if (index($0, "\"agent\":")) next
                if (match($0, /"pane_id"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                    val = substr($0, RSTART, RLENGTH)
                    sub(/^"pane_id"[[:space:]]*:[[:space:]]*"/, "", val)
                    sub(/"$/, "", val)
                    print val
                    exit
                }
            }
          ')

    [[ -z "$pane_id" ]] && pane_id=$(json_find_value "$pane_output" "pane_id")
    [[ -z "$pane_id" ]] && return 0

    # Rename Tab 1 to "agent"
    local tab_id
    tab_id=$(printf '%s\n' "$pane_output" \
        | grep -o '"tab_id":"[^"]*"' | head -1 | cut -d'"' -f4)
    [[ -n "$tab_id" ]] && herdr tab rename "$tab_id" "agent" >/dev/null 2>&1 || true

    # Split 1: pane_id right at 0.50 → claude (50%) | right-area (50%)
    local before_panes after_panes nvim_pane_id
    before_panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null \
        | grep -o '"pane_id":"[^"]*"' | sort)

    herdr pane split "$pane_id" \
        --direction right --ratio 0.50 \
        --cwd "$cwd" --no-focus >/dev/null 2>&1 || true

    after_panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null \
        | grep -o '"pane_id":"[^"]*"' | sort)

    nvim_pane_id=$(comm -13 \
        <(printf '%s\n' "$before_panes") \
        <(printf '%s\n' "$after_panes") \
        | grep -o '"[^"]*"$' | tr -d '"' | head -1)

    [[ -z "$nvim_pane_id" ]] && { printf '%s\n' "$pane_id"; return 0; }

    # Split 2: nvim_pane right at 0.65 → nvim (65% of right) | copse-tree (35% of right)
    before_panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null \
        | grep -o '"pane_id":"[^"]*"' | sort)

    herdr pane split "$nvim_pane_id" \
        --direction right --ratio 0.65 \
        --cwd "$cwd" --no-focus >/dev/null 2>&1 || true

    after_panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null \
        | grep -o '"pane_id":"[^"]*"' | sort)

    local tree_pane_id
    tree_pane_id=$(comm -13 \
        <(printf '%s\n' "$before_panes") \
        <(printf '%s\n' "$after_panes") \
        | grep -o '"[^"]*"$' | tr -d '"' | head -1)

    # Start nvim with socket in nvim_pane (COPSE_NVIM=1 sets copse branding)
    herdr pane run "$nvim_pane_id" \
        "COPSE_NVIM=1 nvim --listen /tmp/copse-nvim-${workspace_id}.sock" \
        >/dev/null 2>&1 || true

    # Start copse-tree in tree_pane
    [[ -n "$tree_pane_id" ]] && \
        herdr pane run "$tree_pane_id" "copse-tree $cwd" >/dev/null 2>&1 || true

    printf '%s\n' "$pane_id"
}

# Start claude in an existing pane.
start_agent() {
    local pane_id="$1"
    [[ -z "$pane_id" ]] && return 0
    herdr pane run "$pane_id" "claude" >/dev/null 2>&1 || true
}

# ─── Subcommands ───────────────────────────────────────────

cmd_worktree() {
    local branch="" project_arg=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)  project_arg="$2"; shift 2 ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse worktree <branch> [--project PATH]" >&2
                exit 1
                ;;
            *) branch="$1"; shift ;;
        esac
    done

    if [[ -z "$branch" ]]; then
        echo "Usage: copse worktree <branch-name> [--project PATH]" >&2
        exit 1
    fi

    local git_root repo_name branch_slug worktree_path label
    git_root=$(detect_project "$project_arg") || exit 1
    repo_name=$(basename "$git_root")
    branch_slug=$(make_branch_slug "$branch")
    label="${repo_name}_${branch_slug}"
    label="${label//./_}"; label="${label//:/_}"

    local worktree_list existing_path open_json open_state workspace_id
    worktree_list=$(herdr worktree list --cwd "$git_root" --json 2>/dev/null || true)
    existing_path=$(json_find_worktree_path_for_branch "$worktree_list" "$branch")

    if [[ -n "$existing_path" ]]; then
        worktree_path="$existing_path"
        # Recompute label from actual path (may differ from branch-derived slug)
        label=$(compute_label "$worktree_path")
        open_json=$(herdr worktree open \
            --cwd "$git_root" \
            --path "$worktree_path" \
            --label "$label" \
            --focus \
            --json 2>/dev/null || true)
        if printf '%s\n' "$open_json" | grep -q '"already_open":true'; then
            open_state="existing"
        else
            open_state="created"
        fi
    else
        worktree_path="$WORKTREES_DIR/$repo_name/$branch_slug"
        mkdir -p "$WORKTREES_DIR/$repo_name"
        open_json=$(herdr worktree create \
            --cwd "$git_root" \
            --branch "$branch" \
            --path "$worktree_path" \
            --label "$label" \
            --focus \
            --json 2>/dev/null || true)
        open_state="created"
    fi

    workspace_id=$(json_find_value "$open_json" "workspace_id")

    if [[ -z "$workspace_id" ]]; then
        echo "Error: failed to open/create worktree for $branch" >&2
        exit 1
    fi

    local is_new="false"
    [[ "$open_state" == "created" ]] && is_new="true"

    local agent_pane_id
    agent_pane_id=$(start_agent_layout "$workspace_id" "$is_new" "$worktree_path")
    start_agent "$agent_pane_id"

    [[ -z "${HERDR_ENV:-}" ]] && exec herdr
}

cmd_fan() {
    local task="" count=3 project_arg=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --count)   count="$2";       shift 2 ;;
            --project) project_arg="$2"; shift 2 ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse fan \"<task>\" [--count N] [--project PATH]" >&2
                exit 1
                ;;
            *) task="$1"; shift ;;
        esac
    done

    if [[ -z "$task" ]]; then
        echo "Usage: copse fan \"<task>\" [--count N] [--project PATH]" >&2
        exit 1
    fi

    local git_root repo_name slug
    git_root=$(detect_project "$project_arg") || exit 1
    repo_name=$(basename "$git_root")
    slug=$(make_slug "$task" 30)

    local -a workspace_ids=()
    local -a worktree_paths=()
    local -a branches=()

    local i
    for i in $(seq 1 "$count"); do
        local branch="fan/${slug}-${i}"
        local branch_slug="fan-${slug}-${i}"
        local worktree_path="$WORKTREES_DIR/$repo_name/$branch_slug"
        local label="${repo_name}_${branch_slug}"
        label="${label//./_}"; label="${label//:/_}"

        mkdir -p "$WORKTREES_DIR/$repo_name"

        local create_json workspace_id
        create_json=$(herdr worktree create \
            --cwd "$git_root" \
            --branch "$branch" \
            --path "$worktree_path" \
            --label "$label" \
            --no-focus \
            --json 2>/dev/null || true)
        workspace_id=$(json_find_value "$create_json" "workspace_id")

        if [[ -z "$workspace_id" ]]; then
            echo "Warning: failed to create worktree for $branch — skipping" >&2
            continue
        fi

        workspace_ids+=("$workspace_id")
        worktree_paths+=("$worktree_path")
        branches+=("$branch")

        local agent_pane_id
        agent_pane_id=$(start_agent_layout "$workspace_id" "true" "$worktree_path")

        if [[ -n "$agent_pane_id" ]]; then
            # Pass task as CLI arg; --permission-mode overrides defaultMode:plan without
            # writing any config files into the worktree repo.
            # acceptEdits = auto-accept file edits; set COPSE_FAN_PERMISSION_MODE=dontAsk
            # if the agent stalls on Bash permission prompts.
            local fan_permission_mode escaped_task
            fan_permission_mode="${COPSE_FAN_PERMISSION_MODE:-acceptEdits}"
            escaped_task=$(printf '%s' "$task" | sed "s/'/'\\\\''/g")
            herdr pane run "$agent_pane_id" \
                "claude --permission-mode $fan_permission_mode '$escaped_task'" \
                >/dev/null 2>&1 || true
        else
            echo "Warning: no agent pane for workspace $workspace_id" >&2
        fi
    done

    if [[ ${#workspace_ids[@]} -gt 0 ]]; then
        herdr workspace focus "${workspace_ids[0]}" >/dev/null 2>&1 || true
    fi

    echo ""
    echo "Fan-out complete: $count agents → \"$task\""
    printf '%-6s %-35s %s\n' "SLOT" "BRANCH" "PATH"
    printf '%s\n' "----------------------------------------------------------------------"
    local idx=0
    for branch in "${branches[@]}"; do
        printf '%-6s %-35s %s\n' \
            "[$(( idx + 1 ))]" \
            "$branch" \
            "${worktree_paths[$idx]}"
        (( idx++ )) || true
    done
}

cmd_ls() {
    local project_arg="" fan_only="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)   project_arg="$2"; shift 2 ;;
            --fan-only)  fan_only="true";  shift ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse ls [--project PATH] [--fan-only]" >&2
                exit 1
                ;;
            *)
                echo "Unknown argument: $1" >&2
                echo "Usage: copse ls [--project PATH] [--fan-only]" >&2
                exit 1
                ;;
        esac
    done

    local git_root
    git_root=$(detect_project "$project_arg") || exit 1

    printf '%-6s %-40s %-12s %s\n' "SLOT" "BRANCH" "STATUS" "PATH"
    printf '%s\n' "$(printf '%90s' | tr ' ' '-')"

    local slot branch path status pane_id workspace_id
    while IFS=$'\t' read -r slot branch path status pane_id workspace_id; do
        local display_status="$status"
        [[ "$status" == "none" ]] && display_status="(no agent)"
        printf '%-6s %-40s %-12s %s\n' \
            "$slot" \
            "${branch:0:40}" \
            "$display_status" \
            "$path"
    done < <(list_worktrees_with_status "$git_root" "$fan_only")
}

cmd_diff() {
    local project_arg=""
    local -a slots=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --project requires a path argument" >&2
                    exit 1
                fi
                project_arg="$2"; shift 2 ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse diff [slot1] [slot2] [--project PATH]" >&2
                exit 1
                ;;
            *)
                slots+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#slots[@]} -gt 2 ]]; then
        echo "Error: copse diff accepts at most 2 slot arguments" >&2
        echo "Usage: copse diff [slot1] [slot2] [--project PATH]" >&2
        exit 1
    fi

    local git_root
    git_root=$(detect_project "$project_arg") || exit 1

    local main_branch
    main_branch=$(git -C "$git_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    if [[ -z "$main_branch" ]]; then
        if git -C "$git_root" rev-parse --verify main >/dev/null 2>&1; then
            main_branch="main"
        elif git -C "$git_root" rev-parse --verify master >/dev/null 2>&1; then
            main_branch="master"
        else
            main_branch=$(git -C "$git_root" rev-parse --abbrev-ref HEAD 2>/dev/null)
        fi
    fi

    local -a fan_lines=()
    local -a fan_slots=()
    local -a fan_branches=()

    local slot branch path status pane_id workspace_id
    while IFS=$'\t' read -r slot branch path status pane_id workspace_id; do
        [[ -z "$branch" ]] && continue
        local display_status="$status"
        [[ "$status" == "none" ]] && display_status="(no agent)"
        fan_lines+=("[$slot] $branch ($display_status)")
        fan_slots+=("$slot")
        fan_branches+=("$branch")
    done < <(list_worktrees_with_status "$git_root" "true")

    if [[ ${#fan_branches[@]} -eq 0 ]]; then
        echo "No fan worktrees found" >&2
        exit 1
    fi

    local target_branch1="" target_branch2=""

    if [[ ${#slots[@]} -eq 0 ]]; then
        if ! command -v fzf >/dev/null 2>&1; then
            echo "Error: fzf is required for interactive selection" >&2
            exit 1
        fi

        local selected
        selected=$(printf '%s\n' "${fan_lines[@]}" | fzf -m 2 --prompt="Select 1 or 2 slots to diff > ")
        if [[ -z "$selected" ]]; then
            exit 0
        fi

        local sel_count
        sel_count=$(printf '%s\n' "$selected" | wc -l | tr -d ' ')

        if [[ "$sel_count" -eq 1 ]]; then
            local line1
            line1=$(printf '%s\n' "$selected" | head -n1)
            target_branch1="$main_branch"
            target_branch2=$(printf '%s\n' "$line1" | awk '{print $2}')
        elif [[ "$sel_count" -ge 2 ]]; then
            local line1 line2
            line1=$(printf '%s\n' "$selected" | head -n1)
            line2=$(printf '%s\n' "$selected" | sed -n '2p')
            target_branch1=$(printf '%s\n' "$line1" | awk '{print $2}')
            target_branch2=$(printf '%s\n' "$line2" | awk '{print $2}')
        fi
    elif [[ ${#slots[@]} -eq 1 ]]; then
        local s1="${slots[0]}"
        target_branch1="$main_branch"
        local i
        for (( i=0; i<${#fan_slots[@]}; i++ )); do
            if [[ "${fan_slots[$i]}" == "$s1" ]]; then
                target_branch2="${fan_branches[$i]}"
                break
            fi
        done
        if [[ -z "$target_branch2" ]]; then
            echo "Slot $s1 not found" >&2
            exit 1
        fi
    else
        local s1="${slots[0]}" s2="${slots[1]}"
        local i
        for (( i=0; i<${#fan_slots[@]}; i++ )); do
            if [[ "${fan_slots[$i]}" == "$s1" ]]; then
                target_branch1="${fan_branches[$i]}"
            fi
            if [[ "${fan_slots[$i]}" == "$s2" ]]; then
                target_branch2="${fan_branches[$i]}"
            fi
        done
        if [[ -z "$target_branch1" ]]; then
            echo "Slot $s1 not found" >&2
            exit 1
        fi
        if [[ -z "$target_branch2" ]]; then
            echo "Slot $s2 not found" >&2
            exit 1
        fi
    fi

    git -C "$git_root" diff "$target_branch1..$target_branch2"
}

cmd_clean() {
    local project_arg="" force="false" dry_run="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --project requires a path argument" >&2
                    exit 1
                fi
                project_arg="$2"; shift 2 ;;
            --force)   force="true";    shift ;;
            --dry-run) dry_run="true";  shift ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse clean [--force] [--dry-run] [--project PATH]" >&2
                exit 1
                ;;
            *)
                echo "Unknown argument: $1" >&2
                echo "Usage: copse clean [--force] [--dry-run] [--project PATH]" >&2
                exit 1
                ;;
        esac
    done

    local git_root
    git_root=$(detect_project "$project_arg") || exit 1

    local -a target_slots=()
    local -a target_branches=()
    local -a target_paths=()
    local -a target_statuses=()
    local -a target_wids=()

    local skipped_count=0

    local slot branch path status pane_id workspace_id
    while IFS=$'\t' read -r slot branch path status pane_id workspace_id; do
        [[ -z "$branch" ]] && continue
        local display_status="$status"
        [[ "$status" == "none" ]] && display_status="(no agent)"

        if [[ "$force" == "true" ]] || [[ "$status" == "idle" ]] || [[ "$status" == "unknown" ]] || [[ "$status" == "none" ]]; then
            target_slots+=("$slot")
            target_branches+=("$branch")
            target_paths+=("$path")
            target_statuses+=("$display_status")
            target_wids+=("$workspace_id")
        else
            (( skipped_count++ )) || true
        fi
    done < <(list_worktrees_with_status "$git_root" "true")

    if [[ ${#target_branches[@]} -eq 0 ]]; then
        if [[ "$skipped_count" -gt 0 ]]; then
            echo "No idle fan worktrees to clean ($skipped_count active worktree(s) skipped; use --force to clean all)."
        else
            echo "No fan worktrees found to clean."
        fi
        exit 0
    fi

    echo "Fan worktrees to clean:"
    local i
    for (( i=0; i<${#target_branches[@]}; i++ )); do
        printf '  [%s] %-35s (%s)\n' "${target_slots[$i]}" "${target_branches[$i]}" "${target_statuses[$i]}"
    done
    if [[ "$skipped_count" -gt 0 ]]; then
        echo "($skipped_count active worktree(s) skipped; use --force to clean all)"
    fi
    echo ""

    if [[ "$dry_run" == "true" ]]; then
        echo "[dry-run] No changes made."
        exit 0
    fi

    if [[ "$force" == "false" ]]; then
        read -r -p "Delete ${#target_branches[@]} worktree(s)? [y/N] " confirm || confirm=""
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    local cleaned_count=0
    for (( i=0; i<${#target_branches[@]}; i++ )); do
        local b="${target_branches[$i]}"
        local p="${target_paths[$i]}"
        local wid="${target_wids[$i]}"

        if [[ -n "$wid" ]]; then
            herdr worktree remove --workspace "$wid" --force >/dev/null 2>&1 || true
            herdr workspace close "$wid" >/dev/null 2>&1 || true
        fi

        git -C "$git_root" worktree remove --force "$p" >/dev/null 2>&1 || true
        [[ -n "$p" && "$p" != "/" && -d "$p" ]] && rm -rf "$p"
        if [[ -n "$b" ]]; then
            git -C "$git_root" branch -D "$b" >/dev/null 2>&1 || true
        fi
        (( cleaned_count++ )) || true
    done

    git -C "$git_root" worktree prune >/dev/null 2>&1 || true

    echo "Cleaned $cleaned_count fan worktree(s)."
}

cmd_watch() {
    local project_arg=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --project requires a path argument" >&2
                    exit 1
                fi
                project_arg="$2"; shift 2 ;;
            -*)
                echo "Unknown flag: $1" >&2
                echo "Usage: copse watch [--project PATH]" >&2
                exit 1
                ;;
            *)
                echo "Unknown argument: $1" >&2
                echo "Usage: copse watch [--project PATH]" >&2
                exit 1
                ;;
        esac
    done

    local git_root
    git_root=$(detect_project "$project_arg") || exit 1

    local -a slots=()
    local -a branches=()
    local -a pane_ids=()

    local slot branch path status pane_id workspace_id
    while IFS=$'\t' read -r slot branch path status pane_id workspace_id; do
        [[ -z "$branch" ]] && continue
        if [[ -n "$pane_id" ]]; then
            slots+=("$slot")
            branches+=("$branch")
            pane_ids+=("$pane_id")
        fi
    done < <(list_worktrees_with_status "$git_root" "true")

    if [[ ${#pane_ids[@]} -eq 0 ]]; then
        echo "No active fan slots with agent panes found to watch."
        exit 0
    fi

    echo "Watching ${#pane_ids[@]} fan slot(s)... (Press Ctrl+C to stop)"
    local i
    for (( i=0; i<${#pane_ids[@]}; i++ )); do
        printf '  [%s] %-35s (pane: %s)\n' "${slots[$i]}" "${branches[$i]}" "${pane_ids[$i]}"
    done
    echo ""

    cleanup() {
        trap - INT TERM
        printf '\nStopped watching.\n' >&2
        local pids
        pids=$(jobs -p)
        [[ -n "$pids" ]] && kill $pids 2>/dev/null || true
        exit 0
    }
    trap cleanup INT TERM

    for (( i=0; i<${#pane_ids[@]}; i++ )); do
        local s="${slots[$i]}"
        local b="${branches[$i]}"
        local pid="${pane_ids[$i]}"

        (
            while true; do
                if herdr agent wait "$pid" --until blocked >/dev/null 2>&1; then
                    printf '\a'
                    echo ""
                    echo "[copse watch] Slot $s ($b) needs attention!"
                    if command -v osascript >/dev/null 2>&1; then
                        osascript -e 'on run argv' \
                                  -e 'display notification (item 1 of argv) with title "copse watch"' \
                                  -e 'end run' \
                                  -- "Slot $s ($b) is waiting for input" 2>/dev/null || true
                    fi
                    sleep 2
                else
                    break
                fi
            done
        ) &
    done

    wait
}

# ─── Entry point ───────────────────────────────────────────

case "${1:-}" in
    --help | -h) cat <<'EOF'
Usage: copse [path]
       copse new [path]
       copse worktree <branch> [--project PATH]
       copse fan "<task>" [--count N] [--project PATH]
       copse ls [--project PATH] [--fan-only]
       copse diff [slot1] [slot2] [--project PATH]
       copse clean [--force] [--dry-run] [--project PATH]
       copse watch [--project PATH]

  copse [path]              Open (or focus) a workspace for path.
                            Omit path to pick from fzf.
  copse new [path]          Force-create a new workspace even if one
                            already exists for path. Git repos: closes
                            the existing workspace first.
  copse worktree <branch>   Open a git worktree for branch in a new
                            workspace. Creates the worktree if needed.
  copse fan "<task>"        Spin up N parallel agent workspaces for task
                            on separate branches (default N=3).
  copse ls                  List worktrees with agent status.
                            --fan-only  Show only fan/* branches.
  copse diff                Compare fan worktrees by slot numbers or fzf.
  copse clean               Remove idle fan worktrees.
                            --force    Remove all fan worktrees regardless of status.
                            --dry-run  Preview worktrees to remove without deleting.
  copse watch               Watch fan slots and notify when blocked (waiting for input).

Options:
  -h, --help                Show this help.
EOF
        exit 0 ;;
esac

ensure_herdr_server

case "${1:-}" in
    worktree)    shift; cmd_worktree "$@"; exit $? ;;
    fan)         shift; cmd_fan "$@";      exit $? ;;
    ls)          shift; cmd_ls "$@";       exit $? ;;
    diff)        shift; cmd_diff "$@";     exit $? ;;
    clean)       shift; cmd_clean "$@";    exit $? ;;
    watch)       shift; cmd_watch "$@";    exit $? ;;
    new)         shift; force_new="true"  ;;
    *)           force_new="false"        ;;
esac


# Parse args: copse [path]
selected_arg=""
for arg in "$@"; do
    case "$arg" in
        --*)
            echo "Unknown flag: $arg" >&2
            exit 1
            ;;
        *) selected_arg="$arg" ;;
    esac
done

if [[ -n "$selected_arg" ]]; then
    selected=$(cd "$selected_arg" 2>/dev/null && pwd)
    if [[ -z "$selected" || ! -d "$selected" ]]; then
        echo "Directory not found: $selected_arg"
        exit 1
    fi
else
    main_repos=$(find "$PROJECTS_DIR" -maxdepth 3 -name ".git" 2>/dev/null \
        | xargs -n1 dirname 2>/dev/null \
        | grep -v '\.worktrees' \
        | sort -u)
    worktrees=$(find "$WORKTREES_DIR" -maxdepth 2 -mindepth 2 -type d 2>/dev/null \
        | sort -u)

    selected=$(
        {
            printf '%s\n' "$main_repos"
            [[ -n "$worktrees" ]] && printf '[wt] %s\n' $worktrees
        } | fzf --prompt="Project > "
    )
    if [[ -z "$selected" ]]; then
        echo "No project selected"
        exit 0
    fi
    selected="${selected#\[wt\] }"
fi

session_name=$(compute_label "$selected")

workspace_result=$(focus_or_create_workspace "$session_name" "$selected" "$force_new")
workspace_id="${workspace_result%% *}"
workspace_state="${workspace_result#* }"

if [[ "$workspace_state" == "created" || "$workspace_state" == "existing" ]]; then
    is_new="false"
    [[ "$workspace_state" == "created" ]] && is_new="true"

    agent_pane_id=$(start_agent_layout "$workspace_id" "$is_new" "$selected")
    start_agent "$agent_pane_id"
fi

[[ -z "${HERDR_ENV:-}" ]] && exec herdr
