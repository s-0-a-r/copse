#!/bin/bash
# Open a file from broot in the persistent nvim editor tab (Tab 2).

FILE="$1"
[[ -z "$FILE" ]] && exit 0

DIR="$(dirname "$FILE")"

PANE_INFO=$(herdr pane current 2>/dev/null || true)
WORKSPACE_ID=$(printf '%s\n' "$PANE_INFO" \
    | grep -o '"workspace_id":"[^"]*"' | cut -d'"' -f4)
[[ -z "$WORKSPACE_ID" ]] && exit 0

NVIM_SOCKET="/tmp/copse-nvim-${WORKSPACE_ID}.sock"

if [[ -S "$NVIM_SOCKET" ]]; then
    # Open file as new tab in running nvim
    nvim --server "$NVIM_SOCKET" --remote-tab "$FILE" 2>/dev/null || true

    # Focus editor tab in herdr
    TABS=$(herdr tab list --workspace "$WORKSPACE_ID" 2>/dev/null || true)
    EDITOR_TAB_ID=$(printf '%s\n' "$TABS" \
        | tr '\n' ' ' \
        | sed 's/},{/}\
{/g' \
        | awk '
            index($0, "\"label\":\"editor\"") {
                if (match($0, /"tab_id"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                    val = substr($0, RSTART, RLENGTH)
                    sub(/^"tab_id"[[:space:]]*:[[:space:]]*"/, "", val)
                    sub(/"$/, "", val)
                    print val
                    exit
                }
            }
        ')
    [[ -n "$EDITOR_TAB_ID" ]] && herdr tab focus "$EDITOR_TAB_ID" >/dev/null 2>&1 || true
else
    # Fallback: socket not ready, create editor tab and start nvim
    TAB_RESULT=$(herdr tab create \
        --workspace "$WORKSPACE_ID" \
        --cwd "$DIR" \
        --label "editor" \
        --focus 2>/dev/null || true)
    PANE_ID=$(printf '%s\n' "$TAB_RESULT" \
        | grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)
    [[ -z "$PANE_ID" ]] && exit 0
    ESCAPED=$(printf '%s' "$FILE" | sed "s/'/'\\\\''/g")
    herdr pane run "$PANE_ID" \
        "nvim --listen '$NVIM_SOCKET' '$ESCAPED'" >/dev/null 2>&1 || true
fi
